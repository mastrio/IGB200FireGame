  tutorialClips:
  - name: PlayerMoved
    description: "<color=orange>Cool burns</color> \u2192 Small, safe fires \u2192
      Clears old bush \u2192 Keeps bush <color=green>healthy</color> \u2192 <color=yellow>Drag
      and drop to start!</color>"
    videoClip: {fileID: 32900000, guid: c9b4dab26c7091c4ca50ce2fbd7ca7c9, type: 3}
  - name: PlayerMoved2
    description: "<color=yellow>Ground clutter</color> \u2192 Dry leaves and sticks
      \u2192 Burns easily if not cleared \u2192 Clear away with <color=orange>cool
      burns</color>"
    videoClip: {fileID: 32900000, guid: cbc2f74655474ed4382e55e1e9d08a5f, type: 3}
  - name: FirePlaced
    description: "Place <color=orange>cool burns</color> \u2192 Burn <color=yellow>ground
      clutter</color>\u2192 <color=green>Lowers fire danger rating</color> \u2192
      Helps prevent big fires \u2192 <color=yellow>Gain Score!</color>"
    videoClip: {fileID: 32900000, guid: 94a07fd63b398bd42a18234a5eb97f94, type: 3}
  - name: FireManagementBar
    description: "<color=yellow>Tap bar</color> \u2192 Keep fire safe in <color=green>middle</color>
      \u2192 <color=red>High</color>, fire is out-of-contol \u2192 <color=#00BFFF>Low</color>,
      fire goes out"
    videoClip: {fileID: 32900000, guid: 5a56a03f27c11f54bacca9ee23735117, type: 3}
  - name: FireManagement
    description: "Manage <color=orange>cool burns</color> \u2192 Stop out-of-control
      fires \u2192 <color=green>Protect environment!</color>"
    videoClip: {fileID: 32900000, guid: d7b30ed6b6ee30f448ca0976d8940399, type: 3}
  - name: MapOpened
    description: "<color=red>Avoid high fuel areas!</color> \u2192 Thick bush \u2192
